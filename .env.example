# ==============================================================================
# Supabase PostgreSQL Database Credentials
# ==============================================================================
# In your Supabase Dashboard:
# Go to Project Settings -> Database -> Connection string -> URI
#
# Option A: Connection Pooler (Recommended - Port 6543, Transaction mode)
# Format: jdbc:postgresql://aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: Direct Connection (Port 5432)
# Format: jdbc:postgresql://db.[project-ref].supabase.co:5432/postgres?sslmode=require

SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:6543/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
